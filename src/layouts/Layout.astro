---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsappFloat from "../components/WhatsappFloat.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import "../styles/global.css";
import { SITE, withBase } from "../data/site";
import geistRegularUrl from "../fonts/Geist-Regular.otf?url";
import bigShouldersBoldUrl from "../fonts/BigShouldersDisplay-Bold.ttf?url";
import proyectoLogo from "../assets/brand/proyecto-cubo.png";
import objetoLogo from "../assets/brand/objeto-cubo.png";
import { GA_MEASUREMENT_ID } from "../data/analytics";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  brand?: "proyecto" | "objeto";
}

const { title, description, noindex = true, brand = "proyecto" } = Astro.props;
const pageTitle = title === SITE.nombre ? title : `${title}, ${SITE.nombre}`;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogLogo = brand === "objeto" ? objetoLogo : proyectoLogo;
const ogImageURL = canonicalURL ? new URL(ogLogo.src, canonicalURL.origin) : undefined;

const organizacionJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.nombre,
  description: SITE.descripcion,
  ...(canonicalURL && { url: canonicalURL.origin + withBase("/") }),
  email: SITE.email,
  sameAs: [SITE.instagramEstudio, SITE.instagramObjeto].filter(Boolean),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL.toString()} />}
    {ogImageURL && <meta property="og:image" content={ogImageURL.toString()} />}
    {ogImageURL && <meta property="og:image:width" content={String(ogLogo.width)} />}
    {ogImageURL && <meta property="og:image:height" content={String(ogLogo.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL.toString()} />}

    <link rel="icon" href={withBase("/favicon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />

    <link rel="preload" href={geistRegularUrl} as="font" type="font/otf" crossorigin />
    <link rel="preload" href={bigShouldersBoldUrl} as="font" type="font/ttf" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(organizacionJsonLd)} />

    {GA_MEASUREMENT_ID && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag("js", new Date());
          gtag("config", GA_MEASUREMENT_ID);
        </script>
      </Fragment>
    )}

    <noscript>
      <style>
        [data-reveal],
        [data-reveal-group] > * {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body data-brand={brand}>
    <LoadingScreen brand={brand} />
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header brand={brand} />
    <main id="contenido">
      <slot />
    </main>
    <Footer brand={brand} />
    <WhatsappFloat />

    <script>
      function initReveal() {
        const targets = document.querySelectorAll("[data-reveal], [data-reveal-group]");
        if (!targets.length) return;

        if (!("IntersectionObserver" in window)) {
          targets.forEach((el) => el.classList.add("is-visible"));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.05, rootMargin: "0px 0px -5% 0px" }
        );

        targets.forEach((el) => io.observe(el));
      }

      initReveal();
      document.addEventListener("astro:page-load", initReveal);
    </script>

    <script>
      function hideLoadingScreen() {
        document.getElementById("loading-screen")?.classList.add("is-hidden");
      }

      window.addEventListener("load", () => setTimeout(hideLoadingScreen, 350));
      setTimeout(hideLoadingScreen, 1800);

      function setupBrandTransitions() {
        const screen = document.getElementById("loading-screen");
        const logo = document.getElementById("loading-screen-logo") as HTMLImageElement | null;
        const title = document.getElementById("loading-screen-title");
        if (!screen || !logo || !title) return;

        const rawBase = screen.dataset.base ?? "/";
        const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
        const objetoPath = base + "objeto";

        function isObjetoHref(href: string) {
          return href === objetoPath || href.startsWith(objetoPath + "/");
        }

        const currentIsObjeto = document.body.dataset.brand === "objeto";
        const proyectoLogo = screen.dataset.proyectoLogo ?? "";
        const objetoLogo = screen.dataset.objetoLogo ?? "";
        const proyectoNombre = screen.dataset.proyectoNombre ?? "Proyecto S3";
        const objetoNombre = screen.dataset.objetoNombre ?? "Objeto S3";

        document.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
          const href = link.getAttribute("href");
          if (!href || href.startsWith("http") || href.startsWith("#") || link.target === "_blank") return;

          const goingToObjeto = isObjetoHref(href);
          const isCrossBrand = currentIsObjeto ? !goingToObjeto : goingToObjeto;
          if (!isCrossBrand) return;

          link.addEventListener("click", (e) => {
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            screen.dataset.brand = goingToObjeto ? "objeto" : "proyecto";
            logo.src = goingToObjeto ? objetoLogo : proyectoLogo;
            title.textContent = goingToObjeto ? objetoNombre : proyectoNombre;
            screen.classList.remove("is-hidden");
            setTimeout(() => {
              window.location.href = href;
            }, 450);
          });
        });
      }

      setupBrandTransitions();
      document.addEventListener("astro:page-load", setupBrandTransitions);
    </script>

    <script>
      // Eventos de Analytics: un solo listener delegado en vez de tocar cada
      // componente. Ver MD de Analytics de Deploy para los nombres exactos
      // y para "marca"/"ubicacion"/"pieza" (parámetros por el tipo de sitio:
      // dos emprendimientos con contacto propio, mismo canal repetido en
      // varios lugares, catálogo de productos).
      function trackEvent(nombre: string, params?: Record<string, string>) {
        const gtag = (window as any).gtag;
        if (typeof gtag === "function") gtag("event", nombre, params);
      }

      document.addEventListener("click", (e) => {
        const link = (e.target as HTMLElement)?.closest?.("a[href]") as HTMLAnchorElement | null;
        if (!link) return;

        const marca = document.body.dataset.brand || "proyecto";
        const ubicacionEl = link.closest<HTMLElement>("[data-ubicacion]");
        const ubicacion = ubicacionEl?.dataset.ubicacion ?? "otro";
        const params: Record<string, string> = { marca, ubicacion };
        if (link.dataset.pieza) params.pieza = link.dataset.pieza;

        const href = link.href;
        if (href.includes("wa.me")) trackEvent("click_whatsapp", params);
        else if (href.includes("instagram.com")) trackEvent("click_instagram", params);
        else if (href.startsWith("mailto:") || href.includes("mail.google.com/mail")) trackEvent("click_email", params);
        else if (link.closest("nav") || link.classList.contains("btn-crossbrand")) trackEvent("navigation_click", params);
      });
    </script>
  </body>
</html>
