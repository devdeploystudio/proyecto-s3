---
import { SITE, linkWhatsapp, withBase } from "../data/site";

interface Props {
  brand?: "proyecto" | "objeto";
}

const { brand = "proyecto" } = Astro.props;
const isObjeto = brand === "objeto";
const year = new Date().getFullYear();
---

<footer class="footer" data-brand={brand}>
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{isObjeto ? "Objeto" : SITE.nombre}</p>
      <p class="footer__tag">
        {isObjeto ? "Muebles de diseño, hechos a pedido." : "Arquitectura y construcción, de padre a hijo."}
      </p>
      <div class="footer__contact">
        <a class="footer__social" href={isObjeto ? SITE.instagramObjeto : SITE.instagramEstudio} target="_blank" rel="noopener noreferrer">
          <svg class="footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="6" width="18" height="14" rx="3"></rect>
            <circle cx="12" cy="13" r="4"></circle>
            <path d="M8 6l1.4-2h5.2L16 6"></path>
          </svg>
          <span>{isObjeto ? "@object.s3" : "@proyecto.s3"}</span>
        </a>
        <a class="footer__social" href={linkWhatsapp("Hola! Quería consultar por un proyecto.")} target="_blank" rel="noopener noreferrer">
          <svg class="footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.463 3.488A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"></path>
          </svg>
          <span>+54 9 11 5555-0123</span>
        </a>
        <a class="footer__social" href="https://mail.google.com/mail/?view=cm&fs=1&to=proyecto.s3object@gmail.com&su=Consulta%20por%20un%20proyecto" target="_blank" rel="noopener noreferrer">
          <svg class="footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3.5 6.5 12 13l8.5-6.5"></path>
          </svg>
          <span>proyecto.s3object@gmail.com</span>
        </a>
      </div>
    </div>

    {isObjeto ? (
      <nav aria-label="Enlaces del pie de página" class="footer__links">
        <a href={withBase("/objeto/")}>Piezas</a>
        <a href={withBase("/")} class="footer__proyecto-link">Proyecto S3</a>
      </nav>
    ) : (
      <nav aria-label="Enlaces del pie de página" class="footer__links">
        <a href={withBase("/estudio/")}>Estudio</a>
        <a href={withBase("/proyectos/")}>Proyectos</a>
        <a href={withBase("/objeto/")} class="footer__objeto-link">Objeto</a>
        <a href={withBase("/contacto/")}>Contacto</a>
      </nav>
    )}
  </div>
  <div class="wrap footer__bottom">
    <p>© {year} {isObjeto ? "Objeto, un proyecto de Proyecto S3" : SITE.nombre}. Todos los derechos reservados.</p>
    <p class="footer__credit">
      Sitio realizado por <a class="footer__credit-brand" href="https://deploystudio.com.ar/" target="_blank" rel="noopener noreferrer">/deploy_</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--paper-alt);
  }

  .footer[data-brand="objeto"] {
    background: var(--sage-soft);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    padding-block: 3rem;
  }

  .footer__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    transition: color 0.15s ease;
  }

  .footer[data-brand="proyecto"] .footer__name:hover {
    color: var(--terracota);
  }

  .footer[data-brand="objeto"] .footer__name:hover {
    color: var(--sage-ink);
  }

  .footer__tag {
    color: var(--stone);
    margin-top: 0.35rem;
    font-size: 0.95rem;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  .footer__links a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
  }

  .footer[data-brand="proyecto"] .footer__links a:hover {
    color: var(--terracota);
  }

  .footer[data-brand="proyecto"] .footer__links a.footer__objeto-link:hover {
    color: var(--sage-ink);
  }

  .footer[data-brand="objeto"] .footer__links a:hover {
    color: var(--sage-ink);
  }

  .footer[data-brand="objeto"] .footer__links a.footer__proyecto-link:hover {
    color: var(--terracota);
  }

  .footer__contact {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--stone);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .footer[data-brand="proyecto"] .footer__social:hover {
    color: var(--terracota);
  }

  .footer[data-brand="objeto"] .footer__social:hover {
    color: var(--sage-ink);
  }

  .footer__social-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--stone);
  }

  .footer__credit-brand {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--stone);
    text-decoration: none;
    letter-spacing: -0.01em;
  }


  .footer[data-brand="proyecto"] .footer__credit a:hover {
    color: var(--terracota);
  }

  .footer[data-brand="objeto"] .footer__credit a:hover {
    color: var(--sage-ink);
  }
</style>
