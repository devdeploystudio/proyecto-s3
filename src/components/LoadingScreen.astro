---
import { Image } from "astro:assets";
import { SITE } from "../data/site";
import proyectoCubo from "../assets/brand/proyecto-cubo.png";
import objetoCubo from "../assets/brand/objeto-cubo.png";

interface Props {
  brand?: "proyecto" | "objeto";
}

const { brand = "proyecto" } = Astro.props;
const isObjeto = brand === "objeto";
const nombre = isObjeto ? "Objeto S3" : SITE.nombre;
const logo = isObjeto ? objetoCubo : proyectoCubo;
---

<div
  id="loading-screen"
  class="loading-screen"
  data-brand={brand}
  data-base={import.meta.env.BASE_URL}
  data-proyecto-logo={proyectoCubo.src}
  data-objeto-logo={objetoCubo.src}
  data-proyecto-nombre={SITE.nombre}
  data-objeto-nombre="Objeto S3"
  aria-hidden="true"
>
  <Image id="loading-screen-logo" src={logo} alt="" width={72} height={72} class="loading-screen__logo" />
  <p id="loading-screen-title" class="loading-screen__title">{nombre}</p>
</div>

<style>
  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--terracota);
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .loading-screen[data-brand="objeto"] {
    background: var(--sage-ink);
  }

  .loading-screen.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loading-screen :global(.loading-screen__logo) {
    display: block;
    width: 64px;
    height: 64px;
    filter: brightness(0) invert(1);
    animation: loading-pulse 1.4s ease-in-out infinite;
  }

  .loading-screen__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: var(--paper);
  }

  @keyframes loading-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.85;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-screen :global(.loading-screen__logo) {
      animation: none;
    }
  }
</style>
