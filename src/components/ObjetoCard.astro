---
import { Image } from "astro:assets";
import type { Pieza } from "../data/objeto";
import { COLORES } from "../data/objeto";
import { linkWhatsapp } from "../data/site";

interface Props {
  pieza: Pieza;
}

const { pieza } = Astro.props;
const formatoPrecio = new Intl.NumberFormat("es-AR", {
  style: "currency",
  currency: "ARS",
  maximumFractionDigits: 0,
});

// Solo se muestra un círculo por cada color que esta pieza tiene realmente
// fotografiado (foto.color en su YAML) — no toda la paleta global.
const coloresDisponibles = COLORES.filter((color) =>
  pieza.foto.some((f) => f.color === color.nombre)
);
---

<article class="pieza">
  <div class="pieza__img">
    {pieza.foto.map((foto, i) => (
      <Image
        src={foto.imagen}
        alt={foto.color ? `${pieza.nombre} en color ${foto.color}` : `${pieza.nombre}, ${pieza.tipo}`}
        width={640}
        height={640}
        class:list={["pieza__slide", pieza.slug === "prisma" && !foto.color && "pieza__slide--recorte", i === 0 && "is-active"]}
        data-color={foto.color}
      />
    ))}
    {pieza.foto.length > 1 && (
      <>
        <button type="button" class="pieza__nav pieza__nav--prev" aria-label={`Foto anterior de ${pieza.nombre}`}>‹</button>
        <button type="button" class="pieza__nav pieza__nav--next" aria-label={`Foto siguiente de ${pieza.nombre}`}>›</button>
      </>
    )}
    <span class="pieza__img-caption" aria-hidden="true" hidden></span>
  </div>
  <div class="pieza__body">
    <p class="pieza__tipo">{pieza.tipo}</p>
    <h3 class="pieza__nombre">{pieza.nombre}</h3>
    <p class="pieza__medidas">{pieza.medidas}</p>
    <p class="pieza__nota">Medida y color ajustables a pedido, según el módulo del material.</p>

    {coloresDisponibles.length > 0 && (
      <>
        <p class="pieza__colores-label">Colores de cerámica disponibles</p>
        <ul class="pieza__colores">
          {coloresDisponibles.map((color) => (
            <li>
              <button type="button" class="pieza__color" style={`--swatch: ${color.swatch}`} data-nombre={color.nombre} aria-label={`Ver ${pieza.nombre} en color ${color.nombre}`}>
                <span class="pieza__color-tooltip" aria-hidden="true">{color.nombre}</span>
              </button>
            </li>
          ))}
        </ul>
      </>
    )}

    <div class="pieza__footer">
      {pieza.precio && <p class="pieza__precio">{formatoPrecio.format(pieza.precio)}</p>}
      <a class="btn btn--sage" href={linkWhatsapp(`Hola! Quería consultar por la mesa ${pieza.nombre}.`)} target="_blank" rel="noopener noreferrer">
        Consultar →
      </a>
    </div>
  </div>
</article>

<style>
  .pieza {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--white);
  }

  .pieza__img {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--sage-soft);
    overflow: hidden;
  }

  .pieza__img :global(.pieza__slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .pieza__img :global(.pieza__slide.is-active) {
    opacity: 1;
  }

  .pieza__img :global(.pieza__slide--recorte) {
    object-position: center 85%;
  }

  .pieza__img-caption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    background: rgba(20, 12, 8, 0.72);
    color: var(--paper);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    z-index: 2;
  }

  .pieza__img-caption[hidden] {
    display: none;
  }

  .pieza__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 253, 251, 0.88);
    color: var(--ink);
    font-size: 1.3rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .pieza__nav:hover {
    background: var(--white);
  }

  .pieza__nav--prev {
    left: 0.6rem;
  }

  .pieza__nav--next {
    right: 0.6rem;
  }

  .pieza__body {
    padding: 1.4rem 1.5rem 1.6rem;
  }

  .pieza__tipo {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--sage-ink);
  }

  .pieza__nombre {
    font-size: 1.7rem;
    margin-top: 0.3rem;
  }

  .pieza__medidas {
    margin-top: 0.4rem;
    color: var(--stone);
    font-size: 0.95rem;
  }

  .pieza__nota {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--stone);
  }

  .pieza__colores-label {
    margin-top: 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--stone);
  }

  .pieza__colores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .pieza__color {
    --swatch: #fff;
    position: relative;
    display: block;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    overflow: visible;
    border: none;
    padding: 0;
    cursor: pointer;
    background: none;
  }

  .pieza__color::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    background:
      radial-gradient(circle at 33% 28%, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0) 55%),
      var(--swatch);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.14);
    transition: box-shadow 0.15s ease;
  }

  .pieza__color.is-selected::before {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.14), 0 0 0 2px var(--white), 0 0 0 4px var(--sage-ink);
  }

  .pieza__color-tooltip {
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.3rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
    z-index: 2;
  }

  .pieza__color:hover .pieza__color-tooltip,
  .pieza__color:focus-visible .pieza__color-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .pieza__footer {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pieza__precio {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
  }
</style>

<script>
  // Las fotos de color (foto.color en el YAML de la pieza) son fotos reales
  // de la pieza, mezcladas en el mismo carrusel que el resto — clickear un
  // color simplemente navega el carrusel a esa foto puntual y lo marca
  // como seleccionado. Clickear el mismo color de nuevo (o usar las
  // flechas) retoma el autoplay normal.
  function initPieza(pieza: HTMLElement) {
    const img = pieza.querySelector<HTMLElement>(".pieza__img");
    const caption = pieza.querySelector<HTMLElement>(".pieza__img-caption");
    const botones = Array.from(pieza.querySelectorAll<HTMLElement>(".pieza__color"));
    if (!img) return;

    const slides = Array.from(img.querySelectorAll<HTMLElement>(".pieza__slide"));
    if (!slides.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = Math.max(
      0,
      slides.findIndex((s) => s.classList.contains("is-active"))
    );
    let timer: ReturnType<typeof setInterval> | undefined;

    function mostrar(index: number, colorSeleccionado: string | null = null) {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("is-active", i === current));
      botones.forEach((b) => b.classList.toggle("is-selected", b.dataset.nombre === colorSeleccionado));
      if (caption) {
        if (colorSeleccionado) {
          caption.textContent = colorSeleccionado;
          caption.hidden = false;
        } else {
          caption.hidden = true;
        }
      }
    }

    function startAuto() {
      if (reduceMotion || slides.length <= 1) return;
      stopAuto();
      timer = setInterval(() => mostrar(current + 1), 4000);
    }

    function stopAuto() {
      clearInterval(timer);
    }

    img.querySelector(".pieza__nav--prev")?.addEventListener("click", (e) => {
      e.preventDefault();
      mostrar(current - 1);
      startAuto();
    });
    img.querySelector(".pieza__nav--next")?.addEventListener("click", (e) => {
      e.preventDefault();
      mostrar(current + 1);
      startAuto();
    });

    img.addEventListener("mouseenter", stopAuto);
    img.addEventListener("mouseleave", startAuto);

    botones.forEach((boton) => {
      boton.addEventListener("click", () => {
        const nombre = boton.dataset.nombre ?? null;
        if (boton.classList.contains("is-selected")) {
          mostrar(current);
          startAuto();
          return;
        }
        const idx = slides.findIndex((s) => s.dataset.color === nombre);
        if (idx < 0) return;
        stopAuto();
        mostrar(idx, nombre);
      });
    });

    startAuto();
  }

  function initTodasLasPiezas() {
    document.querySelectorAll<HTMLElement>(".pieza").forEach(initPieza);
  }

  initTodasLasPiezas();
  document.addEventListener("astro:page-load", initTodasLasPiezas);
</script>
