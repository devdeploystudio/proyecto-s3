---
import Layout from "../layouts/Layout.astro";
import { withBase, TEXTO_404 } from "../data/site";
---

<Layout title="Página no encontrada" description="La página que buscás no existe.">
  <section class="section error">
    <div class="wrap error__inner">
      <p class="eyebrow">{TEXTO_404.eyebrow}</p>
      <h1>{TEXTO_404.titulo}</h1>
      <p>{TEXTO_404.texto}</p>
      <a class="btn btn--primary" href={withBase("/")}>{TEXTO_404.botonTexto}</a>
    </div>
  </section>
</Layout>

<style>
  .error {
    padding-block: clamp(5rem, 15vw, 9rem);
  }

  .error__inner {
    text-align: center;
    max-width: 480px;
  }

  h1 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .error__inner p {
    margin-top: 1rem;
    color: var(--stone);
  }

  .error__inner .btn {
    margin-top: 2rem;
  }
</style>
