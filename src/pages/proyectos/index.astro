---
import Layout from "../../layouts/Layout.astro";
import ProyectoCard from "../../components/ProyectoCard.astro";
import { PROYECTOS } from "../../data/proyectos";
---

<Layout
  title="Proyectos"
  description="Reformas y obras de Proyecto S3: cocinas, patios internos, quinchos y parquización."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Proyectos</p>
      <h1>Reformas y obras con identidad propia</h1>
      <p class="lead">
        Cada proyecto parte de la identidad original del espacio y se resuelve con una mirada que
        combina diseño y experiencia constructiva.
      </p>
      <h2 class="visually-hidden">Listado de proyectos</h2>
      <div class="grid-proyectos" data-reveal-group>
        {PROYECTOS.map((p) => <ProyectoCard proyecto={p} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  h1 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .lead {
    margin-top: 1rem;
    max-width: 60ch;
    color: var(--stone);
    font-size: 1.05rem;
  }

  .grid-proyectos {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
