---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { EQUIPO, TEXTO_NOSOTROS } from "../data/equipo";
import { SITE } from "../data/site";
import ctaImg from "../assets/proyectos/b953/comedor-a.jpg";
---

<Layout
  title="Estudio"
  description="Conocé a Proyecto S3: un estudio familiar de arquitectura y construcción integrado por Santino, Marcelo y Lautaro Schembari."
>
  <section class="section intro">
    <div class="wrap intro__inner">
      <div class="intro__media">
        <p>Foto del equipo, próximamente</p>
      </div>
      <div class="intro__text">
        <p class="eyebrow">El estudio</p>
        <h1>Un laburo de familia, atravesado por la arquitectura.</h1>
        {TEXTO_NOSOTROS.map((parrafo) => <p class="intro__p">{parrafo}</p>)}
      </div>
    </div>
  </section>

  <section class="section equipo">
    <div class="wrap">
      <div data-reveal>
        <p class="eyebrow">Quiénes somos</p>
        <h2>El equipo</h2>
      </div>
      <div class="equipo__grid" data-reveal-group>
        {EQUIPO.map((persona) => (
          <article class="persona">
            <div class="persona__foto" data-vacia={!persona.foto}>
              {persona.foto ? (
                <Image src={persona.foto} alt={persona.nombre} width={480} height={480} />
              ) : (
                <span>Foto próximamente</span>
              )}
            </div>
            <h3 class="persona__nombre">{persona.nombre}</h3>
            <p class="persona__rol">{persona.rol}</p>
            <p class="persona__bio">{persona.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta">
    <Image class="cta__bg" src={ctaImg} alt="" width={1920} height={1280} loading="lazy" />
    <div class="cta__overlay"></div>
    <div class="wrap cta__inner" data-reveal>
      <h2>Seguinos en Instagram</h2>
      <p>Ahí compartimos el día a día de las obras y los proyectos en proceso.</p>
      <a class="btn btn--ghost btn--on-photo" href={SITE.instagramEstudio} target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="6" width="18" height="14" rx="3"></rect>
          <circle cx="12" cy="13" r="4"></circle>
          <path d="M8 6l1.4-2h5.2L16 6"></path>
        </svg>
        @proyecto.s3 →
      </a>
    </div>
  </section>
</Layout>

<style>
  .intro__inner {
    display: grid;
    grid-template-columns: minmax(220px, 380px) 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  .intro__media {
    aspect-ratio: 4 / 5;
    border: 1px dashed var(--stone);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--stone);
    background: var(--paper-alt);
    font-size: 0.95rem;
    text-align: center;
    padding: 1rem;
  }

  .intro h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 5vw, 3.2rem);
  }

  .intro__p {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    color: var(--ink);
    max-width: 65ch;
  }

  @media (max-width: 720px) {
    .intro__inner {
      grid-template-columns: 1fr;
    }

    .intro__media {
      aspect-ratio: 16 / 9;
    }
  }

  .equipo {
    padding-top: 0;
  }

  .equipo h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .equipo__grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2.5rem;
  }

  .persona__foto {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--paper-alt);
    max-width: 280px;
    margin-inline: auto;
  }

  .persona__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .persona__foto[data-vacia="true"] {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--stone);
    color: var(--stone);
    font-size: 0.9rem;
    text-align: center;
    padding: 1rem;
  }

  .persona__nombre {
    margin-top: 1.1rem;
    font-size: 1.4rem;
  }

  .persona__rol {
    margin-top: 0.25rem;
    color: var(--terracota);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .persona__bio {
    margin-top: 0.75rem;
    color: var(--stone);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .cta :global(.cta__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(20, 12, 8, 0.75), rgba(20, 12, 8, 0.72));
  }

  .cta__inner {
    text-align: center;
    max-width: 560px;
  }

  .cta__inner h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    color: var(--paper);
  }

  .cta__inner p {
    margin-top: 0.75rem;
    color: var(--blush-soft);
  }

  .cta__inner .btn {
    margin-top: 1.5rem;
  }

  .btn--on-photo {
    border-color: var(--paper);
    color: var(--paper);
  }

  .btn--on-photo:hover {
    background: var(--paper);
    color: var(--ink);
  }
</style>
